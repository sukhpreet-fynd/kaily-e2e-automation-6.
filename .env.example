# Selects an entry from the APPROVED allowlist in src/config/env.ts (prod | uat).
# Default is prod. KAILY_ORG_ID / KAILY_BASE_URL below are OPTIONAL overrides and
# must match the selected env; mismatches are rejected.
KAILY_ENV=prod
KAILY_ORG_ID=
KAILY_BASE_URL=
# Required for prod (populate from verified deployment); unused for uat (baked in).
KAILY_MAIN_API_BASE_URL=
KAILY_API_ORIGINS=
KAILY_AUTH_STATE_PATH=.auth/user.json
KAILY_TIMEZONE=Asia/Kolkata
KAILY_POLL_TIMEOUT_MS=45000
# Inbound writes remain disabled until these are configured and isolation confirmed.
KAILY_ENABLE_INBOUND=false
KAILY_SIDE_EFFECTS_ISOLATED=false
KAILY_COPILOT_APP_ID=
KAILY_INTEGRATIONS_API_BASE_URL=
KAILY_INTEGRATION_ID=
KAILY_INTEGRATION_TOKEN=
# Optional. Enables the public-API authz checks when set; otherwise those tests skip.
KAILY_PUBLIC_API_BASE_URL=
# Optional. When set, account-auth.spec.ts adds a revoked-token 401 check.
KAILY_REVOKED_BEARER=
# Optional. When "true", enables the opt-in read-only rate-limit probe.
KAILY_PROBE_RATE_LIMITS=false
# Optional. SCA gate: "high" fails on high|critical, "critical" fails only on critical.
SCA_FAIL_LEVEL=high
